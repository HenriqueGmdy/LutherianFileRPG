.sectionTitleWrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
    margin-bottom: 15px;
    width: 100%;
}
.titleLine {
    width: 100%;
    border: 0;
    height: 1px;
    background: var(--bg-fieldset, #555);
    margin: 0;
}
.sectionTitle {
    margin: 5px 0;
    font-size: 1.3rem;
    font-family: var(--font-title);
}

