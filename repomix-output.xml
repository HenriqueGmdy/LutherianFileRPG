    aspect-ratio: 0.85;
    border: 2px dashed #555;
    background: var(--bg-fieldset, rgba(0,0,0,0.3));
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 15px;
}

.basicSplitColumns {
    display: flex;
    gap: 20px;
}
.basicSubLeft { flex: 0 0 55%; }

.basicSubRight {
    flex: 1;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    margin-top: 35px; 
}

.smallBoxInput {
    background: var(--bg-inputs, #2b2b2b);
    border: 1px solid #444;
    color: var(--text-color, #fff);
    width: 45px;
    text-align: center;
    padding: 3px;
