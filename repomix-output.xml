                            <div class="inlineDataGroup">
                                <label for="speed">Deslocamento final:</label>
                                <input type="number" id="speed" min="0" value="6" class="smallBoxInput" readonly aria-label="Deslocamento final calculado"> <span class="unit">qds</span>
                            </div>
                        </div>
                    </div>

                    <div class="statusRightColumn">
                        <div class="resourceBlock">
                            <h3 class="resourceTitle">Vontade</h3>
                            <div class="resourceBarContainer willpowerBarContainer">
                                <div id="willpowerBarFill" class="willpowerFill"></div>
                                <input type="range" id="willpowerRange" min="0" max="0" value="0" class="resourceRangeSlider" aria-label="Vontade atual">
                            </div>
                            <div class="resourceCounter">
                                <input type="number" id="willpowerCurrent" value="0" class="invisibleInput resourceInput">
                                <span>/</span>
                                <input type="number" id="willpowerTotal" value="0" class="invisibleInput resourceInput">
                            </div>
                        </div>

                        <div class="inspirationBlock">
                            <h3 class="resourceTitle">Inspiração</h3>
                            <div class="inspirationCheckboxWrapper">
                                <label class="inspirationControl" aria-label="Inspiração">
                                    <input type="checkbox" id="inspiration" class="inspiration-check">
                                    <span aria-hidden="true"></span>
                                </label>
                            </div>
                        </div>

                        <div class="stressConditionBlock">
                            <button type="button" id="rollStressBtn" class="d20Button" title="Rolar Condição de Estresse">🎲</button>
                            <div id="stressConditionBox" class="stressConditionBox">
                                <h4 id="stressConditionName">Condições de Estresse</h4>
                                <p id="stressConditionDesc">Nenhuma condição ativa.</p>
                                <div class="is-hidden">
                                    <input type="checkbox" id="afflictedCheck">
                                    <input type="checkbox" id="virtuousCheck">
                                </div>
                            </div>
                        </div>

                        <div class="defMoraleBlock">
                            <div class="shieldContainer" title="Classe de Defesa">
                                <input type="number" id="defense" min="0" value="0" class="invisibleInput statusIconInput shieldInput" aria-label="Classe de Defesa">
                            </div>
                            <div class="moraleContainer" title="Moral">
                                <input type="number" id="morale" value="0" class="invisibleInput statusIconInput moraleInput" aria-label="Moral">
                            </div>
                        </div>

                        <div class="inlineDataGroup threatLevelGroup">
                            <label for="threatLevel">Nível de Ameaça:</label>
                            <div class="threatLevelControl">
                                <select id="threatLevel" class="invisibleSelect">
                                    <option value="nulo">Nulo</option>
                                    <option value="sublime">Sublime</option>
                                    <option value="besta">Besta</option>
                                    <option value="demonio">Demônio</option>
                                    <option value="anciao">Ancião</option>
                                    <option value="radiante">Radiante</option>
                                </select>
                                <img id="threatLevelIcon" class="threatLevelIcon" src="assets/images/threat/null.png" alt="Nulo">
                            </div>
                        </div>
                    </div>
                </div>

                <div class="sectionTitleWrapper sectionTitleWrapper--spaced">
                    <hr class="titleLine"><h2 class="sectionTitle titleFont">PERÍCIAS</h2><hr class="titleLine">
                </div>
                <fieldset class="fieldset--unstyled">
                    <div id="skillsContainer" class="skillsContainer"></div>
                </fieldset>

            </div>

            <!-- ABA 2: HABILIDADES -->
            <div id="habilidades" class="tabContent">
                <fieldset>
                    <legend>Habilidades, Magias e Poderes</legend>
                    <div class="notesGrid mb-20">
                        <textarea id="abilityMainDesc" class="notesTextArea" placeholder="Descreva habilidades, magias ou poderes..."></textarea>
                        <textarea id="abilityExtraDesc" class="notesTextArea" placeholder="Outras habilidades ou detalhes adicionais..."></textarea>
                    </div>
                </fieldset>

                <!-- Espaço livre caso queira adicionar listas dinâmicas de magias/talentos de classe depois -->
                <fieldset>
                    <legend>Notas de Combate e Poderes Especiais</legend>
                    <div class="fullWidthBlock">
                        <textarea id="combatAbilitiesNotes" class="notesTextArea narrativeArea" placeholder="Detalhes de conjuração, efeitos ativos ou restrições..."></textarea>
                    </div>
                </fieldset>
            </div>

            <!-- ABA 3: DETALHES -->
            <div id="detalhes" class="tabContent">
                <fieldset>
                    <legend>Pessoal</legend>
                    <div class="personalContainer">
                        <div class="personalSection">
                            <div class="personalSectionHeader">
                                <h3>Proficiências</h3>
                                <button type="button" class="addItemBtn" data-target="proficienciesList">+ Adicionar</button>
                            </div>
                            <div id="proficienciesList" class="dynamicList stringList"></div>
                        </div>
                        <div class="personalSection">
                            <div class="personalSectionHeader">
                                <h3>Talentos</h3>
                                <button type="button" class="addItemBtn" data-target="talentsList">+ Adicionar</button>
                            </div>
                            <div id="talentsList" class="dynamicList cardList"></div>
                        </div>
                        <div class="personalSection">
                            <div class="personalSectionHeader">
                                <h3>Idiomas</h3>
                                <button type="button" class="addItemBtn" data-target="languagesList">+ Adicionar</button>
                            </div>
                            <div id="languagesList" class="dynamicList stringList"></div>
                        </div>
                        <div class="personalSection">
                            <div class="personalSectionHeader">
                                <h3>Doenças</h3>
                                <button type="button" class="addItemBtn" data-target="diseasesList">+ Adicionar</button>
                            </div>
                            <div id="diseasesList" class="dynamicList cardList"></div>
                        </div>
                        <div class="personalSection">
                            <div class="personalSectionHeader">
                                <h3>Traços e Manias</h3>
                                <button type="button" class="addItemBtn" data-target="traitsList">+ Adicionar</button>
                            </div>
                            <div id="traitsList" class="dynamicList cardList"></div>
                        </div>
                        <div class="personalColumnsRow">
                            <div class="personalColumnBox">
                                <label for="scarsText">Marcas / Cicatrizes</label>
                                <textarea id="scarsText" placeholder="Descreva marcas, cicatrizes ou características físicas marcantes..."></textarea>
                            </div>
                            <div class="personalColumnBox">
                                <label for="idealsText">Ideais / Feitos</label>
                                <textarea id="idealsText" placeholder="Descreva crenças, motivações ou grandes feitos..."></textarea>
                            </div>
                            <div class="personalColumnBox">
                                <label for="bondsText">Laços</label>
                                <textarea id="bondsText" placeholder="Descreva conexões, aliados ou promessas importantes..."></textarea>
                            </div>
                        </div>
                    </div>
                </fieldset>

                <fieldset>
                    <legend>Inventário</legend>
                    <div class="inventoryContainer">
                        <div class="inventoryTopGrid">
                            <div class="inventoryBlock">
                                <span class="invTitle">Moedas:</span>
                                <div class="invInputWrapper">
                                    <input type="text" id="coinsInput" value="4d6" class="invCoinsInput">
                                    <span class="invTitle">valores</span>
                                </div>
                            </div>
                            <div class="inventoryBlock">
                                <div class="invCapacityHeader">
                                    <span class="invTitle">Capacidade de Carga:</span>
                                    <span id="loadDisplay" class="loadDisplayValue">0 / 3</span>
                                </div>
                                <div class="backpackOptions">
                                    <label class="stressCheckboxLabel">
                                        <input type="checkbox" id="backpackCheck"> Mochila? (+10 espaços)
                                    </label>
                                    <label class="stressCheckboxLabel">
                                        <input type="checkbox" id="bigBackpackCheck"> Mochila grande? (+22 espaços, -1 Força)
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div id="encumbranceAlerts" class="encumbranceAlerts"></div>
                        <div class="personalSectionHeader personalSectionHeader--spaced">
                            <h3>Itens</h3>
                            <button type="button" class="addItemBtn" id="addInventoryItemBtn">+ Adicionar Item</button>
                        </div>
                        <div id="inventoryItemsList" class="dynamicList"></div>
                    </div>
                </fieldset>

                <fieldset>
                    <legend>Narrativa e Anotações</legend>
                    <div class="fullWidthBlock">
                        <textarea id="narrativeNotes" class="notesTextArea narrativeArea" placeholder="História, anotações de campanha, pistas e diário de missões..."></textarea>
                    </div>
                </fieldset>
            </div>
        </div>
    </div>

    <script type="module" src="script.js"></script>
</body>
</html>
</file>

</files>
