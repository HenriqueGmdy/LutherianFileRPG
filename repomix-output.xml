/* TIPOGRAFIA E CAMPOS INVISÍVEIS DO TOPO */
.titleFont {
    font-family: var(--font-title);
    color: var(--accent-color, #ffcc00);
    text-transform: uppercase;
    letter-spacing: 1px;
    font-size: 1.4rem;
}

.subFont {
    font-family: var(--font-sub);
    color: var(--text-color, #ffffff);
}
.invisibleInput, .invisibleSelect, .invisibleTextarea {
    background: transparent;
    border: none;
    outline: none;
    color: inherit;
    font-family: inherit;
}
.invisibleInput:focus, .invisibleSelect:focus, .invisibleTextarea:focus {
    border-bottom: 1px dashed #666;
}
.invisibleInput[type="number"]::-webkit-inner-spin-button, 
.invisibleInput[type="number"]::-webkit-outer-spin-button { 
    -webkit-appearance: none; margin: 0; 
}
.invisibleInput[type="number"] { -moz-appearance: textfield; }

.invisibleSelect option {
    background-color: var(--bg-inputs, #2b2b2b);
    color: var(--text-color, #ffffff);
}

