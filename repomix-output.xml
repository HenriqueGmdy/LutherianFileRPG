.topSplitContainer {
    display: flex;
    gap: 20px;
    align-items: flex-start;
    padding-right: 15px; /* Cria o pequeno espaço simétrico na direita do bloco Básico */
    box-sizing: border-box;
}
.leftProfileColumn {
    flex: 0 0 30%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
}
.rightBasicColumn {
    flex: 1;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
}

.threatMeterBar {
    width: 12px;
    height: 60px;
    background: #111;
    border: 1px solid var(--bg-fieldset, #444);
    border-top: none;
    border-radius: 0 0 4px 4px;
    margin-top: -26px;
}
.stressSquaresContainer {
    display: flex;
    flex-direction: row;
    justify-content: center;
    gap: 4px;
    margin-top: 2px;
